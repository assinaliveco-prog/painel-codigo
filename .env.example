# ====================================================================
# Copie este arquivo para  .env  e preencha os valores.
#   cp .env.example .env
# ====================================================================

# Dominio que aponta pra esta VPS (crie um registro DNS tipo A: dominio -> IP da VPS).
# Ex: codigos.seudominio.com
DOMAIN=codigos.assinaia.com

# Caminho SECRETO do painel. E a "senha embutida no link".
# Gere um valor aleatorio longo:   openssl rand -hex 16
PANEL_SLUG=troque_por_um_valor_aleatorio_de_32_caracteres

# Token que o Google Apps Script usa pra enviar os codigos.
# Tem que ser IGUAL ao do arquivo apps-script/Code.gs.
# Gere com:   openssl rand -hex 24
INGEST_TOKEN=troque_por_outro_valor_aleatorio_de_48_caracteres

# Texto que aparece no topo do painel.
ACCOUNT_LABEL=Conta Microsoft do time

# Quantos codigos guardar no historico (opcional).
MAX_CODES=50
